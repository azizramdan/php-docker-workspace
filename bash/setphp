#!/bin/bash

if TTY_PATH=$(tty 2>/dev/null); then
    CACHE_FILE="/tmp/php_container_cache_$(echo "$TTY_PATH" | tr '/' '_')"
else
    CACHE_FILE="/tmp/php_container_cache_default"
fi
DEFAULT_CACHE_FILE="/tmp/php_container_cache_default"
SUPPORTED_VERSIONS=("85" "84" "83" "82" "81" "80" "74" "72")

VERSION="$1"
SET_DEFAULT=false
if [ "$2" = "--default" ]; then
    SET_DEFAULT=true
elif [ -n "$2" ]; then
    echo "Error: unknown option '$2'" >&2
    exit 1
fi

if [ -z "$VERSION" ]; then
    echo "Usage: setphp <version> [--default]"
    echo "Available versions: ${SUPPORTED_VERSIONS[*]}"
    exit 1
fi

# Check if version is valid
if ! [[ " ${SUPPORTED_VERSIONS[*]} " =~ " $VERSION " ]]; then
    echo "Error: PHP version '$VERSION' is not supported. Choose from: ${SUPPORTED_VERSIONS[*]}" >&2
    exit 1
fi

# Set the container name in cache
CONTAINER="docker-php${VERSION}-1"
echo "$CONTAINER" > "$CACHE_FILE"
echo "PHP container set to: $CONTAINER (this terminal only)"

if [ "$SET_DEFAULT" = true ]; then
    echo "$CONTAINER" > "$DEFAULT_CACHE_FILE"
    echo "Also set as the global default (used outside any terminal, e.g. VSCode's php.validate.executablePath)"
fi
