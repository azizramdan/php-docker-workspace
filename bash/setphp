#!/bin/bash

if TTY_PATH=$(tty 2>/dev/null); then
    CACHE_FILE="/tmp/php_container_cache_$(echo "$TTY_PATH" | tr '/' '_')"
else
    CACHE_FILE="/tmp/php_container_cache_default"
fi
SUPPORTED_VERSIONS=("85" "84" "83" "82" "81" "80" "74" "72")

if [ -z "$1" ]; then
    echo "Usage: setphp <version>"
    echo "Available versions: ${SUPPORTED_VERSIONS[*]}"
    exit 1
fi

# Check if version is valid
if ! [[ " ${SUPPORTED_VERSIONS[*]} " =~ " $1 " ]]; then
    echo "Error: PHP version '$1' is not supported. Choose from: ${SUPPORTED_VERSIONS[*]}" >&2
    exit 1
fi

# Set the container name in cache
CONTAINER="docker-php${1}-1"
echo "$CONTAINER" > "$CACHE_FILE"
echo "PHP container set to: $CONTAINER (this terminal only)"
