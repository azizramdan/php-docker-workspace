#!/bin/bash

CACHE_FILE="/tmp/php_container_cache"
CONTAINERS=("docker-php84-1" "docker-php83-1" "docker-php82-1" "docker-php81-1" "docker-php80-1" "docker-php74-1" "docker-php72-1")

# Decide if we need interactive mode
if [[ -t 0 && -t 1 ]]; then
    # Running in a terminal → interactive
    EXEC_OPTS="-it"
else
    # Non-interactive (e.g. piping, scripts)
    EXEC_OPTS=""
fi

# Try to use cached container first (if it exists and is running)
if [ -f "$CACHE_FILE" ]; then
    cached_container=$(cat "$CACHE_FILE")
    if docker ps --format '{{.Names}}' | grep -q "^${cached_container}\$"; then
        docker exec $EXEC_OPTS -w "$(pwd)" "$cached_container" php "$@"
        exit $?
    fi
fi

# Find the first running container
selected_container=""
for container in "${CONTAINERS[@]}"; do
    if docker ps --format '{{.Names}}' | grep -q "^${container}\$"; then
        selected_container="$container"
        echo "$container" > "$CACHE_FILE"  # Cache the selected container
        break
    fi
done

if [ -z "$selected_container" ]; then
    echo "Error: No PHP Docker containers are running (tried: ${CONTAINERS[*]})" >&2
    exit 1
fi

docker exec $EXEC_OPTS -w "$(pwd)" "$selected_container" php "$@"